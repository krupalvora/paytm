# Generated as .env by deploy/bootstrap.sh; shown here for reference.
SITE_ADDRESS=203-0-113-7.sslip.io   # hostname => automatic HTTPS; ":80" => plain HTTP
POSTGRES_PASSWORD=...
ADMIN_TOKEN=...                     # Bearer token for POST /shows
JWT_SECRET=...                      # HS256 key for user tokens
GRAFANA_ADMIN_PASSWORD=...
LOGS_USER=viewer
LOGS_PASSWORD=...                   # basic auth for /logs/
WEB_CONCURRENCY=2                   # uvicorn workers
DB_POOL_MAX=20                      # per worker
UPSTREAM_MAX_CONNS=256              # Caddy -> app concurrency cap
LOG_LEVEL=INFO
# Local testing of the prod stack on non-privileged ports:
# HTTP_PORT=8088
# HTTPS_PORT=8443
